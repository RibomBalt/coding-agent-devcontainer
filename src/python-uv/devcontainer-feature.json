{
    "id": "python-uv",
    "version": "1.0.2",
    "name": "Python & UV",
    "description": "Installs the uv Python package manager and configures the PyPI mirror.",
    "options": {
        "pypi_mirror": {
            "type": "string",
            "default": "https://pypi.tuna.tsinghua.edu.cn/simple",
            "description": "PyPI mirror to use for uv"
        }
    },
    "mounts": [
        {
            "source": "devcontainer-uv-cache",
            "target": "/home/node/.cache/uv",
            "type": "volume"
        }
    ],
    "installsAfter": []
}
