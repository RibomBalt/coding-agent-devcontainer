{
    "id": "dsh",
    "version": "1.0.1",
    "name": "DeepSeek Harness",
    "description": "Installs and launches the DeepSeek Harness Web UI.",
    "options": {
        "version": {
            "type": "string",
            "default": "master",
            "description": "DeepSeek Harness source branch or tag"
        }
    },
    "mounts": [
        {
            "source": "dsh-config",
            "target": "/home/node/.dsh",
            "type": "volume"
        }
    ],
    "postCreateCommand": "/home/node/.local/bin/install-dsh-source.sh",
    "postStartCommand": "/home/node/.local/bin/start-dsh-web.py",
    "installsAfter": []
}
