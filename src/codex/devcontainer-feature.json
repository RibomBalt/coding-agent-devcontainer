{
    "id": "codex",
    "version": "1.0.3",
    "name": "Codex Coding Agent",
    "description": "Installs and launches the OpenAI Codex coding agent.",
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Codex version to install"
        }
    },
    "mounts": [
        {
            "source": "codex-config",
            "target": "/home/node/.codex",
            "type": "volume"
        }
    ],
    "postCreateCommand": "/usr/local/share/codex/install.sh",
    "installsAfter": []
}
