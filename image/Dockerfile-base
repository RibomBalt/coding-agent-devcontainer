FROM debian:13-slim

ARG TZ
ENV TZ="$TZ"

ARG NODE_VERSION=24.19.0
ARG NODE_MIRROR=https://registry.npmmirror.com/-/binary/node

ARG DEBIAN_FRONTEND=noninteractive

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# Use tuna mirrors for faster package installation in China
COPY ./debian-tuna.sources /tmp/debian.sources

# Install basic development tools and iptables/ipset
RUN apt-get update && apt-get install -y --no-install-recommends \
  apt-transport-https \
  ca-certificates && \
  # update apt sources to tuna mirrors
  mv /tmp/debian.sources /etc/apt/sources.list.d/debian.sources && \
  # install packages
  apt-get update && apt-get install -y --no-install-recommends \
  curl \
  wget \
  less \
  git \
  procps \
  sudo \
  fzf \
  zsh \
  man-db \
  unzip \
  gnupg2 \
  gh \
  iptables \
  ipset \
  iproute2 \
  dnsutils \
  aggregate \
  jq \
  nano \
  vim \
  python3 \
  python3-pip \
  openssh-server \
  fd-find \
  build-essential \
  ccache \
  ripgrep \
  rsync \
  tree \
  locales \
  libgl1 \
  && echo "en_US.UTF-8 UTF-8" > /etc/locale.gen \
  && locale-gen en_US.UTF-8 \
  && update-locale LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8 \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Node.js (node / npm / npx) into /usr/local
RUN ARCH=$(dpkg --print-architecture) && \
  case "$ARCH" in \
    amd64) NODE_ARCH=x64 ;; \
    arm64) NODE_ARCH=arm64 ;; \
    *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
  esac && \
  wget -qO /tmp/node.tar.gz "${NODE_MIRROR}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz" && \
  tar -C /usr/local --strip-components=1 -xzf /tmp/node.tar.gz && \
  rm -f /tmp/node.tar.gz && \
  node --version && npm --version

# Create the node user (debian:13-slim has no node user by default)
RUN useradd -m -u 1000 -s /bin/zsh node && \
    # Ensure node user has access to the global npm/pnpm directories
    mkdir -p /usr/local/share/npm-global \
    /usr/local/share/pnpm-global \
    && chown -R node:node /usr/local/share && \
    # Persist bash history.
    mkdir /commandhistory \
    && touch /commandhistory/.bash_history \
    && chown -R node /commandhistory && \
    # Create workspace directory and set permissions
    mkdir -p /workspace && \
    chown -R node:node /workspace

WORKDIR /workspace

# Set up non-root user
USER node

# Set the default shell to zsh rather than sh
ENV SHELL=/bin/zsh

# Set the default editor and visual
ENV EDITOR=vim
ENV VISUAL=vim

# Global npm/pnpm directories
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PNPM_HOME=/usr/local/share/pnpm-global
ENV PATH=$PNPM_HOME/bin:$NPM_CONFIG_PREFIX/bin:$PATH

# Use NPM registry in China and install pnpm
ARG NPM_MIRROR=https://registry.npmmirror.com
RUN npm config set registry "${NPM_MIRROR}" && \
    npm install -g pnpm && \
    pnpm config set registry "${NPM_MIRROR}" && \
    npm cache clean --force && \
    pnpm store prune

# Default powerlevel10k theme
ARG ZSH_IN_DOCKER_VERSION=1.2.0
RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v${ZSH_IN_DOCKER_VERSION}/zsh-in-docker.sh)" -- \
  -p git \
  -p fzf \
  -a "source /usr/share/doc/fzf/examples/key-bindings.zsh" \
  -a "source /usr/share/doc/fzf/examples/completion.zsh" \
  -a "export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  -x

# Install Python UV
COPY install-python-uv.sh /tmp
ENV PATH="/home/node/.local/bin:$PATH"
RUN mkdir -p /home/node/.local/bin && \
    cp /tmp/install-python-uv.sh /home/node/.local/bin/install-python-uv.sh && \
    chmod +x /home/node/.local/bin/install-python-uv.sh && \
    /home/node/.local/bin/install-python-uv.sh

# Copy and set up firewall script / openssh access
COPY init-firewall.sh /usr/local/bin/
USER root
RUN chmod +x /usr/local/bin/init-firewall.sh && \
  echo "node ALL=(root) NOPASSWD: /usr/local/bin/init-firewall.sh" > /etc/sudoers.d/node-firewall && \
  chmod 0440 /etc/sudoers.d/node-firewall
USER node
COPY init-ssh.sh /tmp
# ssh + editor + directory setup
RUN cp /tmp/init-ssh.sh /home/node/.local/bin/init-ssh.sh && \
  chmod +x /home/node/.local/bin/init-ssh.sh && \
  mkdir -p /home/node/.ssh/host_ssh_key && \
  chmod 700 /home/node/.ssh && \
  chmod 700 /home/node/.ssh/host_ssh_key && \
  touch /home/node/.ssh/authorized_keys && \
  chmod 600 /home/node/.ssh/authorized_keys && \
  # vimrc
  echo "set number" > /home/node/.vimrc && \
  echo "set tabstop=4" >> /home/node/.vimrc && \
  echo "set shiftwidth=4" >> /home/node/.vimrc && \
  echo "set expandtab" >> /home/node/.vimrc && \
  echo "set autoindent" >> /home/node/.vimrc && \
  echo "set smartindent" >> /home/node/.vimrc && \
  echo "set cursorline" >> /home/node/.vimrc && \
  echo "set encoding=utf-8" >> /home/node/.vimrc && \
  echo "set fileencoding=utf-8" >> /home/node/.vimrc && \
  echo "syntax on" >> /home/node/.vimrc && \
  echo "set mouse=a" >> /home/node/.vimrc && \
  # git global config (generic identity; agent features override this)
  git config --global user.name "devcontainer" && \
  git config --global user.email "devcontainer@localhost" && \
  # geant4 pybind data
  mkdir -p /home/node/.geant4_pybind
